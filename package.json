{
  "name": "cross-dirs",
  "version": "1.0.1",
  "description": "Platform-specific user directory paths for Node.js and Bun - TypeScript port of dirs-rs",
  "repository": {
    "type": "git",
    "url": "https://github.com/pleahmacaka/cross-dirs"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "test": "bun test",
    "test:node": "node --experimental-vm-modules --import tsx tests/index.test.ts",
    "check": "tsc --noEmit",
    "format": "biome check --write ."
  },
  "keywords": [
    "dirs",
    "directories",
    "xdg",
    "cross-platform",
    "cross-runtime",
    "bun",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  }
}
